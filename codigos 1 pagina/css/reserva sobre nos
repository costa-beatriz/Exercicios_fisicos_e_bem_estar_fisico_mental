



/* ================================= */
/*        FOODER DO CELULAR         */
/* ================================= */

@media screen and (max-width: 599px) {

    footer {
        background-color: #1c4d8d;
        color: #ffffff;
    }


    .footer-container {
        max-width: 900px;
        margin: 0 auto;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 8vw 0 0 0;
        gap: 1.5rem;
        text-align: center;
    }


    /* LOGO */

    .footer-logo {
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .logo-circle-fim {
        width: 30%;
        height: auto;
    }


    /* LINKS */

    .footer-links {
        display: flex;
        flex-direction: column;
        align-items: center;

        gap: 0.8rem;
    }

    .footer-links a {
        color: #ffffff;
        text-decoration: none;
        font-size: 0.85rem;
    }


    /* TEXTOS */

    .footer-copy {
        display: flex;
        flex-direction: column;
        align-items: center;

        gap: 0.5rem;
    }

    .footer-copy p {
        margin: 0;
        font-size: 0.75rem;
        opacity: 0.8;
        font-weight: 700;
        text-align: center;
    }


    /* REDES SOCIAIS */

    .footer-redes {
        display: flex;
        justify-content: center;
        align-items: center;

        gap: 1rem;
    }

    .footer-redes img {
        width: 25px;
        height: 25px;
    }

}

.footer-redes img {

    width: 40%;

    padding: 0 0 1rem 0;

}






